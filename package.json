{
  "name": "@projek-xyz/wp-env",
  "version": "0.0.13",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "commit-and-tag-version": "^13.2.1"
    }
  },
  "scripts": {
    "format": "biome format --write",
    "lint": "biome check",
    "prepare": "simple-git-hooks",
    "release": "bunx commit-and-tag-version -s"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.2",
    "commit-and-tag-version": "catalog:",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "overrides": {
    "@types/node": "24.9.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "parserPreset": {
      "name": "conventionalcommits",
      "presetConfig": {
        "types": [
          {
            "type": "bump",
            "section": "Releases",
            "hidden": false
          }
        ]
      }
    },
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "bump",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  },
  "commit-and-tag-version": {},
  "simple-git-hooks": {
    "commit-msg": "bunx commitlint --edit $1",
    "pre-commit": "bunx lint-staged --allow-empty"
  },
  "lint-staged": {
    "*.{css,jsonc,js,ts}": [
      "biome format --write --no-errors-on-unmatched"
    ],
    "docker/mu-plugins/*.php": [
      "sh -c 'composer format:packages -- \"$@\"; rc=$?; [ \"$rc\" -ge 0 ]' --"
    ],
    "packages/**/*.php": [
      "sh -c 'composer format:packages -- \"$@\"; rc=$?; [ \"$rc\" -ge 0 ]' --",
      "scripts/make-pot.sh"
    ],
    "tests/**/*.php": [
      "sh -c 'composer format:tests -- \"$@\"; rc=$?; [ \"$rc\" -ge 0 ]' --"
    ],
    "{package,tsconfig}.json": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
