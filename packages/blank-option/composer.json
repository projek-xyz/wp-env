{
    "name": "projek-xyz/wp-blank-option",
    "homepage": "https://github.com/projek-xyz/wp-env/",
    "description": "Something awesome is about to come.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Fery Wardiyanto",
            "email": "ferywardiyanto@gmail.com"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/feryardiant"
        }
    ],
    "support": {
        "source": "https://github.com/projek-xyz/wp-env/"
    },
    "require": {
        "php": ">=8.2"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "extra": {
        "version-constants": {
            "BLANK_OPTION_VERSION": "functions.php"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
